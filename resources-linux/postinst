#!/bin/sh
set -e

GROUP_NAME="defguard"
SERVICE_NAME="defguard-service"

# Get the name of user who is installing the client
get_installing_user() {
    # Method 1: Check standard environment variables when installing with CLI
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
        INSTALLING_USER="$SUDO_USER"
    elif [ -n "$USER" ] && [ "$USER" != "root" ]; then
        INSTALLING_USER="$USER"
    fi
    if [ -n "$INSTALLING_USER" ]; then
        echo "$INSTALLING_USER"
        return 0
    fi

    # Method 2: Check loginctl for latest session.
    # Only attempt this if systemd is actually running (PID 1) - during
    # rpm-ostree deployment construction (e.g. on Fedora Atomic / Bazzite)
    # the package scriptlets run in a bwrap container with no systemd/dbus,
    # so loginctl would fail and - combined with `set -e` - abort the whole
    # rpm-ostree transaction.
    if [ -d /run/systemd/system ]; then
        SESSION_ID=$(loginctl show-seat seat0 -p ActiveSession --value 2>/dev/null) || SESSION_ID=""
        if [ -n "$SESSION_ID" ]; then
            username=$(loginctl show-session "$SESSION_ID" -p Name --value 2>/dev/null) || username=""
            if [ -n "$username" ]; then
                echo "$username"
                return 0
            fi
        fi
    fi

    return 1
}

ensure_local_group_entry() {
    # Fedora Atomic systems can provide system groups from /usr/lib/group.
    # usermod may report success for those groups without persisting members
    # in /etc/group, so create a matching local entry before adding users.
    if getent -s files group "$GROUP_NAME" >/dev/null 2>&1; then
        return 0
    fi

    group_gid=""
    group_entry=$(getent group "$GROUP_NAME" 2>/dev/null || true)
    if [ -n "$group_entry" ]; then
        group_gid=$(printf '%s\n' "$group_entry" | cut -d: -f3)
        if ! groupadd --system --force --non-unique --gid "$group_gid" "$GROUP_NAME"; then
            return 1
        fi
    elif ! groupadd --system "$GROUP_NAME"; then
        return 1
    fi

    local_group_entry=$(getent -s files group "$GROUP_NAME" 2>/dev/null || true)
    [ -n "$local_group_entry" ] &&
        { [ -z "$group_gid" ] || [ "$(printf '%s\n' "$local_group_entry" | cut -d: -f3)" = "$group_gid" ]; }
}

is_group_member() {
    id -Gn "$1" | tr ' ' '\n' | grep -Fxq "$GROUP_NAME"
}

case "$1" in
    1|configure)
        if ensure_local_group_entry; then
            LOCAL_GROUP_READY=1
            echo "Group $GROUP_NAME is ready for local membership changes."
        else
            LOCAL_GROUP_READY=0
            echo "Warning: Could not create a local group entry for $GROUP_NAME."
        fi

        # Determine target user. get_installing_user() may legitimately find
        # no user (e.g. unattended/offline installs such as rpm-ostree
        # deployment construction), so don't let `set -e` abort the script
        # when it returns a non-zero status.
        TARGET_USER=$(get_installing_user) || TARGET_USER=""
        echo "Installation triggered by user $TARGET_USER"

        # Add user to group if we found a valid target
        if [ -n "$TARGET_USER" ]; then
            if getent passwd "$TARGET_USER" >/dev/null; then
                if ensure_local_group_entry &&
                    usermod -a -G "$GROUP_NAME" "$TARGET_USER" &&
                    is_group_member "$TARGET_USER"; then
                    echo "Verified user $TARGET_USER is a member of group $GROUP_NAME."
                    # Only show reboot message if user was actually added
                    echo "================================================"
                    echo "  IMPORTANT: Reboot or Re-login Required"
                    echo "================================================"
                    echo "The user has been added to the defguard group."
                    echo "Please reboot or log out and back in for the"
                    echo "group membership changes to take effect."
                    echo "================================================"
                else
                    echo "Warning: Could not verify that user $TARGET_USER is a member of group $GROUP_NAME."
                    echo "The package is installed, but this user may need to be added to the group manually."
                fi
            fi
        else
            echo "No installing user was detected."
            if [ "$LOCAL_GROUP_READY" -eq 1 ]; then
                echo "To grant access later, run: sudo usermod -aG $GROUP_NAME <your-username>"
                echo "Then sign out and back in before using Defguard."
            else
                echo "The user who will run Defguard must be added to group $GROUP_NAME before using the client."
            fi
        fi

        # Handle systemd service
        if [ -d /run/systemd/system ]; then
            echo "Updating systemd service $SERVICE_NAME"

            # Reload systemd to recognize new service file
            systemctl daemon-reload

            # Enable service to start on boot
            systemctl enable "$SERVICE_NAME"

            # On a fresh install ($2 is empty) start the service; on an upgrade
            # ($2 holds the previous version) restart it so the new daemon binary
            # is loaded - otherwise an already-running old daemon keeps serving and
            # lacks newly added RPCs (e.g. list_interfaces used by the CLI).
            if [ -z "$2" ]; then
                systemctl start "$SERVICE_NAME"
            else
                systemctl restart "$SERVICE_NAME"
            fi
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        # On failed operations, ensure service is running if it should be
        if [ -d /run/systemd/system ]; then
            echo "Restarting systemd service $SERVICE_NAME"
            systemctl daemon-reload
            if systemctl is-enabled "$SERVICE_NAME" >/dev/null 2>&1; then
                systemctl start "$SERVICE_NAME" || true
            fi
        fi
        ;;
esac

