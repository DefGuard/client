  "query": "SELECT id \"id!\", location_id,\n            SUM(MAX(upload_diff, 0)) \"upload!: i64\", SUM(MAX(download_diff, 0)) \"download!: i64\", 0 \"upload_diff!: i64\", 0 \"download_diff!: i64\", last_handshake \"last_handshake!: i64\", strftime($1, collected_at) \"collected_at!: NaiveDateTime\", listen_port \"listen_port!: u32\", persistent_keepalive_interval \"persistent_keepalive_interval?: u16\" FROM location_stats WHERE location_id = $2 AND collected_at >= datetime(strftime($1, $3)) GROUP BY strftime($1, collected_at) ORDER BY collected_at LIMIT $4",
