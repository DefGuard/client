{
  "build": {
    "beforeBundleCommand": {
      "cwd": "../swift",
      "script": "./build.sh"
    }
  },
  "bundle": {
    "icon": [
      "icons/macos/32x32.png",
      "icons/macos/128x128.png",
      "icons/macos/128x128@2x.png",
      "icons/macos/icon.icns",
      "icons/macos/icon.ico"
    ],
    "macOS": {
      "bundleVersion": "@BUILD_NUMBER@",
      "minimumSystemVersion": "13.5"
    }
  }
}
